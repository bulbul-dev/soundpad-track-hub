<Window x:Class="SoundpadTrackHub.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundpad Track Hub"
        Width="400" SizeToContent="Height" MinHeight="160"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
                <TextBlock x:Name="TitleText" Margin="14,0,48,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <Button HorizontalAlignment="Right" Style="{StaticResource CaptionButton}" Width="36" Height="36"
                        WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE8BB;" ToolTip="Закрыть"
                        Click="OnCloseClick" IsCancel="True" />
            </Grid>

            <!-- Содержимое -->
            <Grid Grid.Row="1" Margin="18,18,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconHost" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top"
                        Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="17"
                               Foreground="{StaticResource AccentHoverBrush}" Text="&#xE9CE;" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" LineHeight="20" />
                    <TextBlock x:Name="DetailText" Margin="0,8,0,0" Style="{StaticResource Caption}" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Кнопки -->
            <WrapPanel x:Name="ButtonsPanel" Grid.Row="2" HorizontalAlignment="Right" Margin="18,14,12,16" />
        </Grid>
    </Border>
</Window>
