<UserControl x:Class="SoundpadTrackHub.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SoundpadTrackHub.Infrastructure"
             xmlns:views="clr-namespace:SoundpadTrackHub.Views">
    <!-- DataContext: DownloadsViewModel -->
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <infra:NullToVisibilityConverter x:Key="NullToVis" />
        <infra:PercentConverter x:Key="Percent" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,2,6">

            <!-- Громкость -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Text="ГРОМКОСТЬ SOUNDPAD" />
                    <views:SoundpadVolumeSwitch DataContext="{Binding DataContext.Volume, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <TextBlock Style="{StaticResource Overline}" Margin="2,14,0,4" Text="ПРЕДПРОСЛУШИВАНИЕ" />
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,10,0"
                                   ToolTip="Громкость предпрослушивания (не меняет громкость Windows и Soundpad)" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding PreviewVolume, Mode=TwoWay}"
                                ToolTip="Громкость предпрослушивания (не меняет громкость Windows и Soundpad)" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Text="{Binding PreviewVolume, Converter={StaticResource Percent}}" />
                    </Grid>
                    <TextBlock Margin="2,4,0,0" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Text="Громкость предпрослушивания в Track Hub. Системная громкость Windows не меняется." />
                </StackPanel>
            </Border>

            <!-- Сейчас играет -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0" BorderBrush="#553D8BFD"
                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="ПРЕДПРОСЛУШИВАНИЕ" Foreground="{StaticResource AccentHoverBrush}" />
                        <TextBlock Text="{Binding NowPlaying.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Остановить" Command="{Binding StopCommand}" />
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Text="{Binding PositionText}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Уведомление -->
            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="7" BorderThickness="1"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="#443D8BFD" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoticeIsWarning}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="#55E3A33B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="9" Content="&#xE8BB;"
                            Command="{Binding DismissNoticeCommand}" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Список -->
            <Grid Margin="2,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Скачанные треки" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Перетащите трек прямо в список звуков Soundpad" />
                </StackPanel>
                <Button Grid.Column="1" Padding="10,3" MinHeight="28" FontSize="12" VerticalAlignment="Center" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Открыть папку" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16,18" Visibility="{Binding HasItems, Converter={StaticResource InvBoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="22" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                    <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Пока ничего не скачано" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                               Text="Найдите трек на вкладке «Поиск» и нажмите ⬇. После подтверждения файл появится здесь." />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="8,8,6,8" CornerRadius="8" BorderThickness="1"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                Tag="{Binding FilePath}" Cursor="Hand"
                                PreviewMouseLeftButtonDown="OnItemMouseDown" PreviewMouseMove="OnItemMouseMove"
                                ToolTip="Перетащите в Soundpad">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Play / Stop -->
                                <Button Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Width="34" Height="34" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            <Setter Property="Content" Value="&#xE768;" />
                                            <Setter Property="ToolTip" Value="Предпрослушать в выбранном режиме громкости" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Content" Value="&#xE71A;" />
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="ToolTip" Value="Остановить" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="5,0" CornerRadius="4" Background="{StaticResource AccentSoftBrush}" Margin="0,0,6,0"
                                                Visibility="{Binding Badge, Converter={StaticResource NullToVis}}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12.5" ToolTip="{Binding FilePath}" />
                                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE8C8;"
                                            ToolTip="Создать отдельную громкую копию +6 dB с limiter'ом (оригинал не изменяется)"
                                            Command="{Binding DataContext.CreateCopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13" Content="&#xE838;"
                                            ToolTip="Показать в папке"
                                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;"
                                            ToolTip="Убрать из списка (файл останется на диске)"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
