<UserControl x:Class="SoundpadTrackHub.Views.ReplacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SoundpadTrackHub.Infrastructure">
    <!-- DataContext: ReplaceViewModel -->
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Подсказка / шаг -->
        <Border Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <StackPanel Visibility="{Binding IsChoosingSource, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontWeight="SemiBold" FontSize="13" Text="Замена трека в Soundpad" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="Для бесплатной версии Soundpad: новый трек встаёт на место старого звука — номер, категория и горячая клавиша сохраняются. Нажмите «Поменять» у скачанного трека." />
                </StackPanel>
                <Grid Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE72B;" ToolTip="Назад" Command="{Binding BackCommand}" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Caption}" Text="На какой звук Soundpad поменять?" />
                        <TextBlock FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding SelectedSource.FileName}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Статус / поиск по звукам Soundpad -->
        <StackPanel Grid.Row="1" Margin="0,8,0,8">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="12,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Grid.Column="1" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                             Background="Transparent" BorderThickness="0" Padding="4,8" ToolTip="Поиск по звукам и категориям Soundpad" />
                </Grid>
            </Border>
            <TextBlock Margin="2,6,0,0" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Шаг 1: скачанные треки -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsChoosingSource, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,0" Text="Пока ничего не скачано — сначала скачайте трек на вкладке «Поиск»."
                           Visibility="{Binding HasSources, Converter={StaticResource InvBoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="10,8,8,8" CornerRadius="8" BorderThickness="1"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12.5" ToolTip="{Binding FilePath}" />
                                        <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="12,4" MinHeight="30" FontSize="12" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="12" Margin="0,0,6,0" Foreground="White" />
                                            <TextBlock Text="Поменять" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Шаг 2: звуки Soundpad -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Targets}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                 Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,5" Padding="8,6,8,6" CornerRadius="8" BorderThickness="1"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5" ToolTip="{Binding Sound.Url}" />
                                <TextBlock Text="{Binding Meta}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Padding="10,3" MinHeight="28" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding DataContext.ReplaceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" Content="Заменить" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
