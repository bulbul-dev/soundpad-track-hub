<Window x:Class="SoundpadTrackHub.Views.AgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользовательское соглашение"
        Width="460" Height="600" MinWidth="380" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
                <TextBlock Margin="14,0,48,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Text="Soundpad Track Hub" />
                <Button HorizontalAlignment="Right" Style="{StaticResource CaptionButton}" Width="36" Height="36"
                        WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE8BB;" ToolTip="Закрыть"
                        Click="OnDecline" IsCancel="True" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,16,18,10">
                <TextBlock Style="{StaticResource PageTitle}" FontSize="16" Text="Пользовательское соглашение" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Перед первой загрузкой трека прочитайте и примите условия. Без согласия скачивание недоступно." />
            </StackPanel>

            <Border Grid.Row="2" Margin="18,0,18,0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource BgBrush}">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="OnScrollChanged">
                    <TextBlock x:Name="AgreementText" Margin="14,12" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                               Foreground="{StaticResource TextBrush}" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Margin="18,12,18,16">
                <CheckBox x:Name="AcceptBox" Foreground="{StaticResource TextBrush}" Checked="OnAcceptChanged" Unchecked="OnAcceptChanged">
                    <TextBlock TextWrapping="Wrap" Text="Я прочитал(а) соглашение и принимаю его условия, в том числе обязуюсь скачивать только треки, на которые у меня есть права." />
                </CheckBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" MinWidth="120" MinHeight="32"
                            Content="Принимаю" IsEnabled="False" Click="OnAccept" />
                    <Button Margin="8,0,0,0" MinWidth="100" MinHeight="32" Content="Отмена" Click="OnDecline" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
