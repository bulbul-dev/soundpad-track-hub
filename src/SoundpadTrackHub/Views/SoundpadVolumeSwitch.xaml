<UserControl x:Class="SoundpadTrackHub.Views.SoundpadVolumeSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SoundpadTrackHub.Infrastructure">
    <!-- DataContext: SoundpadVolumeViewModel -->
    <UserControl.Resources>
        <infra:EnumEqualsConverter x:Key="EnumEq" />
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource SegmentHost}" IsEnabled="{Binding IsApplying, Converter={x:Static infra:InverseBoolConverter.Instance}}">
            <UniformGrid Rows="1">
                <RadioButton Style="{StaticResource SegmentRadio}" Padding="4,5" GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Content="Нормально" ToolTip="Громкость голоса 80 дБ, динамическая регулировка"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumEq}, ConverterParameter=Normal}" />
                <RadioButton Style="{StaticResource SegmentRadio}" Padding="4,5" GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Content="Громко" ToolTip="Громкость голоса 95 дБ, динамическая регулировка"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumEq}, ConverterParameter=Loud}" />
                <RadioButton Style="{StaticResource SegmentRadio}" Padding="4,5" GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Content="Громко 2" ToolTip="Громкость голоса 107 дБ, динамическая регулировка"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumEq}, ConverterParameter=Loud2}" />
                <RadioButton Style="{StaticResource SegmentRadio}" Padding="4,5" GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Content="Супер громко" ToolTip="Громкость голоса 107 дБ, фиксированная регулировка, подстройка 30 дБ"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource EnumEq}, ConverterParameter=SuperLoud}" />
            </UniformGrid>
        </Border>
        <TextBlock Margin="2,7,0,0" Style="{StaticResource Caption}" Text="{Binding CurrentText}" />
        <TextBlock Margin="2,3,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentHoverBrush}" Text="{Binding PendingText}"
                   Visibility="{Binding PendingText, Converter={StaticResource NullToVis}}" />
        <Border Margin="0,8,0,0" Padding="9,6" CornerRadius="6" Background="{StaticResource WarningSoftBrush}"
                Visibility="{Binding IsSuperLoud, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Caption}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock Margin="2,6,0,0" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                   Text="Меняет «Файл → Настройки → Аудио → Нормализация громкости» в Soundpad. Если Soundpad открыт, его нужно перезапустить — Track Hub спросит." />
    </StackPanel>
</UserControl>
