<Window x:Class="SoundpadTrackHub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:SoundpadTrackHub.ViewModels"
        xmlns:views="clr-namespace:SoundpadTrackHub.Views"
        xmlns:infra="clr-namespace:SoundpadTrackHub.Infrastructure"
        x:Name="Root"
        Title="Soundpad Track Hub"
        Width="460" Height="720" MinWidth="400" MinHeight="480" MaxWidth="640"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <infra:NullToVisibilityConverter x:Key="NullToVis" />
        <infra:EnumEqualsConverter x:Key="EnumEq" />
        <infra:PercentConverter x:Key="Percent" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= Заголовок ================= -->
            <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4D96FF" Offset="0" />
                                <GradientStop Color="#FF2563D6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4F;" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource UiFontDisplay}"
                               FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" />
                </StackPanel>

                <!-- Статус Soundpad -->
                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" Padding="9,3,10,3" CornerRadius="11"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        ToolTip="Состояние Soundpad: Track Hub находит процесс Soundpad.exe и встаёт рядом с его окном">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSoundpadConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSoundpadClosed}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Margin="7,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding SoundpadStateText}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <ToggleButton Style="{StaticResource IconToggleButton}" Width="40" Height="44" FontSize="13"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  IsChecked="{Binding IsDocked}"
                                  Content="&#xE718;" ToolTip="Прикреплять окно к Soundpad" />
                    <Button Style="{StaticResource CaptionButton}" Height="44" WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="&#xE921;" ToolTip="Свернуть" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionCloseButton}" Height="44" Width="44" WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="&#xE8BB;" ToolTip="Закрыть Track Hub" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- ================= Панель действий ================= -->
            <Grid Grid.Row="1" Margin="12,2,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource HeroButton}" Command="{Binding OpenHitmozCommand}" HorizontalContentAlignment="Center"
                        ToolTip="Открыть главную страницу ru.hitmoz.org во встроенном браузере">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="15" Margin="0,0,9,0" />
                        <TextBlock Text="Открыть Hitmoz" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE72B;" ToolTip="Назад"
                            Command="{Binding BackCommand}" />
                    <Button Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE72C;" ToolTip="Обновить страницу"
                            Command="{Binding ReloadCommand}" />
                </StackPanel>
            </Grid>

            <!-- ================= Вкладки + карточка загрузки ================= -->
            <StackPanel Grid.Row="2" Margin="12,0,12,8">
                <Border Style="{StaticResource SegmentHost}">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Pages" Padding="4,5"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Search}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Поиск" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Pages" Padding="4,5"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Browser}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Сайт" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Pages" Padding="4,5"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Downloads}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Загрузки" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Pages" Padding="4,5"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Settings}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Настройки" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <!-- Идёт загрузка -->
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,10"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="16" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ActiveDownloadName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <ProgressBar Margin="0,7,0,0" Minimum="0" Maximum="1" Value="{Binding ActiveDownloadProgress, Mode=OneWay}"
                                         IsIndeterminate="{Binding ActiveDownloadIndeterminate, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="8,0,0,0" Content="&#xE711;"
                                ToolTip="Отменить загрузку (временный файл будет удалён)" Command="{Binding CancelDownloadCommand}" />
                    </Grid>
                </Border>

                <!-- Загрузка завершена -->
                <Border x:Name="CompletedCard" Margin="0,8,0,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                        Background="{StaticResource SuccessSoftBrush}" BorderBrush="#553FB950" Cursor="Hand"
                        Visibility="{Binding HasLastCompleted, Converter={StaticResource BoolToVis}}"
                        ToolTip="Перетащите карточку в список звуков Soundpad"
                        PreviewMouseLeftButtonDown="OnFileDragStart" PreviewMouseMove="OnFileDragMove" Tag="{Binding LastCompletedPath}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="16" Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Top" Margin="0,2,10,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding LastCompletedName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding LastCompletedPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       ToolTip="{Binding LastCompletedPath}" />
                            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                       Text="{Binding LastCompletedHint}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Показать в папке" Padding="10,3" MinHeight="26" FontSize="12" Command="{Binding RevealCompletedCommand}" />
                                <Button Content="Загрузки" Padding="10,3" MinHeight="26" FontSize="12" Margin="6,0,0,0"
                                        Command="{Binding ShowPageCommand}" CommandParameter="Downloads" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="10" VerticalAlignment="Top"
                                Content="&#xE8BB;" ToolTip="Скрыть" Command="{Binding DismissCompletedCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ================= Содержимое ================= -->
            <Grid Grid.Row="3" Margin="12,0,12,0">

                <!-- Сайт Hitmoz (WebView2) -->
                <Grid Visibility="{Binding IsBrowserPage, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="{Binding IsBrowserLoading, Mode=OneWay}"
                                 Visibility="{Binding IsBrowserLoading, Converter={StaticResource BoolToVis}}" />
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}" Padding="1"
                            Visibility="{Binding IsWebViewVisible, Converter={StaticResource BoolToVis}}">
                        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#FF1E2128" />
                    </Border>

                    <!-- Честный экран ошибки: без демо-треков и подмены сайта -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsBrowserErrorVisible, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Card}" Padding="20,24" VerticalAlignment="Top" Margin="0,8,0,8">
                            <StackPanel>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource WarningSoftBrush}" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding BrowserErrorGlyph}" FontSize="22"
                                               Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="0,14,0,0" Style="{StaticResource PageTitle}" FontSize="17" Text="{Binding BrowserErrorTitle}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="12.5" LineHeight="18" Text="{Binding BrowserErrorText}" />

                                <Button Margin="0,18,0,0" Style="{StaticResource PrimaryButton}" MinHeight="36" HorizontalAlignment="Stretch"
                                        Command="{Binding OpenExternalCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="0,0,8,0" />
                                        <TextBlock Text="Открыть Hitmoz во внешнем браузере" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,8,0,0" MinHeight="34" HorizontalAlignment="Stretch" Command="{Binding GetWebView2Command}"
                                        Visibility="{Binding IsRuntimeMissing, Converter={StaticResource BoolToVis}}"
                                        Content="Скачать WebView2 Runtime с сайта Microsoft" />
                                <UniformGrid Rows="1" Margin="0,8,0,0">
                                    <Button MinHeight="34" Margin="0,0,4,0" Command="{Binding RetryCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                                            <TextBlock Text="Повторить" />
                                        </StackPanel>
                                    </Button>
                                    <Button MinHeight="34" Margin="4,0,0,0" Command="{Binding ShowSiteAnywayCommand}"
                                            Visibility="{Binding IsForbidden, Converter={StaticResource BoolToVis}}"
                                            Content="Показать страницу" />
                                </UniformGrid>
                                <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Track Hub не показывает демо-треки вместо сайта и не обходит защиту Hitmoz." />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- Поиск -->
                <views:SearchPage DataContext="{Binding Search}"
                                  Visibility="{Binding DataContext.IsSearchPage, ElementName=Root, Converter={StaticResource BoolToVis}}" />

                <!-- Загрузки -->
                <views:DownloadsPage DataContext="{Binding Downloads}"
                                     Visibility="{Binding DataContext.IsDownloadsPage, ElementName=Root, Converter={StaticResource BoolToVis}}" />

                <!-- Настройки -->
                <views:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}" />

                <!-- Безопасность и права -->
                <views:SecurityPage Visibility="{Binding IsSecurityPage, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- ================= Нижняя строка ================= -->
            <Border Grid.Row="4" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{StaticResource SurfaceBrush}" Padding="8,6,10,7">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Padding="8,2" MinHeight="26" FontSize="12" Background="Transparent" BorderThickness="0"
                                Command="{Binding OpenFolderCommand}" ToolTip="{Binding DownloadFolder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Открыть папку" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Padding="8,2" MinHeight="26" FontSize="12" Background="Transparent" BorderThickness="0"
                                Command="{Binding ShowPageCommand}" CommandParameter="Security">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Безопасность и права" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BrowserState}" Value="Ready">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BrowserState}" Value="Loading">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BrowserState}" Value="Unavailable">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BrowserState}" Value="Forbidden">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BrowserState}" Value="RuntimeMissing">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="6,0,0,0" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ConnectionText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="8,3,0,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
