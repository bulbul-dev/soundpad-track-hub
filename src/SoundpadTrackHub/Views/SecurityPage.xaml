<UserControl x:Class="SoundpadTrackHub.Views.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SoundpadTrackHub.Views">
    <!-- DataContext: MainViewModel -->
    <UserControl.Resources>
        <DataTemplate x:Key="Rule">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NotRule">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,2,6">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Назад к сайту" Margin="-6,0,6,0"
                        Command="{Binding ShowPageCommand}" CommandParameter="Browser" />
                <TextBlock Grid.Column="1" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0" Text="Безопасность и права" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Text="КАК ЭТО РАБОТАЕТ" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                               Text="Сайт ru.hitmoz.org открывается во встроенном браузере Microsoft WebView2 — так же, как в обычном браузере. Вы сами ищете трек на сайте и нажимаете на сайте штатную кнопку скачивания MP3. Track Hub не использует API Hitmoz и не отправляет на сайт скрытых запросов." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Text="ПРАВИЛА ЗАГРУЗКИ" />
                    <ItemsControl ItemTemplate="{StaticResource Rule}">
                        <ItemsControl.Items>
                            <x:Static Member="views:SecurityTexts.Https" />
                            <x:Static Member="views:SecurityTexts.Host" />
                            <x:Static Member="views:SecurityTexts.Mp3" />
                            <x:Static Member="views:SecurityTexts.Blocked" />
                            <x:Static Member="views:SecurityTexts.Confirm" />
                            <x:Static Member="views:SecurityTexts.Overwrite" />
                            <x:Static Member="views:SecurityTexts.Temp" />
                            <x:Static Member="views:SecurityTexts.Popups" />
                            <x:Static Member="views:SecurityTexts.Search" />
                            <x:Static Member="views:SecurityTexts.SoundpadApi" />
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Text="ЧЕГО TRACK HUB НЕ ДЕЛАЕТ" />
                    <ItemsControl ItemTemplate="{StaticResource NotRule}">
                        <ItemsControl.Items>
                            <x:Static Member="views:SecurityTexts.NoBypass" />
                            <x:Static Member="views:SecurityTexts.NoScraping" />
                            <x:Static Member="views:SecurityTexts.NoInjection" />
                            <x:Static Member="views:SecurityTexts.NoVolume" />
                            <x:Static Member="views:SecurityTexts.NoMock" />
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,8,0,0" Padding="14,12" CornerRadius="8" Background="{StaticResource WarningSoftBrush}" BorderBrush="#55E3A33B" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Права на треки" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                               Text="{x:Static views:SecurityTexts.Rights}" />
                </StackPanel>
            </Border>

            <Button Margin="0,12,0,0" HorizontalAlignment="Stretch" MinHeight="34" Command="{Binding OpenExternalCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="0,0,8,0" />
                    <TextBlock Text="Открыть Hitmoz во внешнем браузере" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
