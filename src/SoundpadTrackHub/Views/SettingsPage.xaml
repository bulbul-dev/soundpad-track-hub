<UserControl x:Class="SoundpadTrackHub.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SoundpadTrackHub.Views">
    <!-- DataContext: MainViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,2,6" DataContext="{Binding SettingsPage}">

            <!-- Папка загрузок -->
            <TextBlock Style="{StaticResource Overline}" Text="ПАПКА ЗАГРУЗОК" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBox Text="{Binding DownloadFolder, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding DownloadFolder}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Padding="12,4" MinHeight="30" Margin="0,0,6,0" Content="Выбрать папку…"
                                Command="{Binding ChooseFolderCommand}" />
                        <Button Padding="12,4" MinHeight="30" Margin="0,0,6,0" Command="{Binding OpenFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Открыть папку" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,4" MinHeight="30" Content="По умолчанию" Command="{Binding ResetFolderCommand}"
                                ToolTip="Музыка\Soundpad Track Hub" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Soundpad -->
            <TextBlock Style="{StaticResource Overline}" Margin="2,16,0,6" Text="SOUNDPAD И WINDOWS" />
            <Border Style="{StaticResource Card}" Padding="14,4">
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,8" IsChecked="{Binding DockToSoundpad}">
                        <StackPanel>
                            <TextBlock Text="Прикреплять к окну Soundpad" />
                            <TextBlock Style="{StaticResource Caption}" Text="Справа от Soundpad, если нет места — слева. Окно следует за Soundpad." />
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,8" IsChecked="{Binding AddToSoundpadCategory}">
                        <StackPanel>
                            <TextBlock Text="Добавлять треки в Soundpad" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CategoryHint}" />
                        </StackPanel>
                    </CheckBox>
                    <Button HorizontalAlignment="Left" Padding="10,3" MinHeight="26" FontSize="12" Margin="0,0,0,8"
                            Content="Добавить все скачанные сейчас" Command="{Binding SyncSoundpadCommand}" />
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,8" IsChecked="{Binding HideWhenSoundpadClosed}">
                        <StackPanel>
                            <TextBlock Text="Скрывать, когда Soundpad закрыт" />
                            <TextBlock Style="{StaticResource Caption}" Text="Track Hub остаётся в области уведомлений и появится снова при запуске Soundpad." />
                        </StackPanel>
                    </CheckBox>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,8" IsChecked="{Binding AutostartEnabled}">
                        <StackPanel>
                            <TextBlock Text="Запускать вместе с Windows" />
                            <TextBlock Style="{StaticResource Caption}" Text="Запись в HKCU\…\Run, права администратора не нужны. При автозапуске окно ждёт Soundpad." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Громкость -->
            <TextBlock Style="{StaticResource Overline}" Margin="2,16,0,6" Text="ГРОМКОСТЬ SOUNDPAD" />
            <Border Style="{StaticResource Card}">
                <views:SoundpadVolumeSwitch DataContext="{Binding DataContext.Volume, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Border>

            <!-- Безопасность -->
            <TextBlock Style="{StaticResource Overline}" Margin="2,16,0,6" Text="БЕЗОПАСНОСТЬ" />
            <Button HorizontalContentAlignment="Stretch" Padding="14,10" Command="{Binding DataContext.ShowPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="Security">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="16" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Безопасность и права" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" Text="Правила загрузки, что Track Hub делает и чего не делает" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Button>

            <!-- О программе -->
            <TextBlock Style="{StaticResource Overline}" Margin="2,16,0,6" Text="О ПРОГРАММЕ" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock>
                        <Run Text="Soundpad Track Hub" FontWeight="SemiBold" />
                        <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                               Text="Hitmoz открывается во встроенном браузере Microsoft WebView2. Track Hub не использует API Hitmoz и не изменяет Soundpad." />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                   Text="{Binding DataFolder, StringFormat=Данные: {0}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Button Grid.Column="1" Padding="10,2" MinHeight="26" FontSize="12" Margin="8,0,0,0" Content="Журналы" Command="{Binding OpenLogsCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Удаление -->
            <TextBlock Style="{StaticResource Overline}" Margin="2,16,0,6" Text="УДАЛЕНИЕ" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Удаляет только Track Hub: автозапуск, ярлыки и файлы программы. Soundpad не затрагивается. Про настройки и скачанные треки будет отдельный вопрос." />
                    <Button Margin="0,10,0,0" Style="{StaticResource DangerOutlineButton}" HorizontalAlignment="Left" Padding="14,5"
                            Command="{Binding UninstallCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Удалить приложение" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
