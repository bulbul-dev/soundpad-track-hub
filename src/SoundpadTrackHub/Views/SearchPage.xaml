<UserControl x:Class="SoundpadTrackHub.Views.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SoundpadTrackHub.Infrastructure">
    <!-- DataContext: SearchViewModel -->
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <infra:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Строка поиска -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="12,0,4,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <Grid Grid.Column="1">
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"
                               Text="Название трека или исполнитель"
                               Visibility="{Binding HasQuery, Converter={StaticResource InvBoolToVis}}" />
                    <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="13.5"
                             Background="Transparent" BorderThickness="0" Padding="4,10" KeyDown="OnQueryKeyDown" />
                </Grid>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="10" Margin="0,0,4,0"
                        Content="&#xE8BB;" ToolTip="Очистить" Command="{Binding ClearCommand}"
                        Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- Статус -->
        <Grid Grid.Row="1" Margin="2,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressBar Width="18" Height="3" Margin="0,0,8,0" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Результаты -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,2,6">
                <Border Style="{StaticResource Card}" Padding="16,18" Visibility="{Binding HasResults, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="22" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                        <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Поиск по Hitmoz" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                   Text="Начните печатать — варианты появятся сами. ▶ — послушать, ⬇ — скачать (с подтверждением). Скачанные треки попадают в Soundpad в категорию «Soundpad Track Hub»." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,5" Padding="6,6,6,6" CornerRadius="8" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Width="34" Height="34" Margin="0,0,10,0"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                                <Setter Property="Content" Value="&#xE768;" />
                                                <Setter Property="ToolTip" Value="Послушать (плеер сайта Hitmoz)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Content" Value="&#xE769;" />
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="ToolTip" Value="Пауза" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,6,0" />

                                    <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Width="34" Height="34" MinHeight="0" Padding="0"
                                            FontFamily="{StaticResource IconFont}" FontSize="14" Content="&#xE896;" FontWeight="Normal"
                                            ToolTip="Скачать MP3 (будет запрошено подтверждение)"
                                            Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="2,6,0,0" Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"
                           Text="Результаты взяты со страницы поиска ru.hitmoz.org во встроенном браузере (вкладка «Сайт»). Проверяйте права на использование треков." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
